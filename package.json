{
  "name": "@menelaos/react-natal-chart",
  "version": "0.4.0",
  "description": "A React component for rendering natal (and transit bi-wheel) astrology charts as SVG.",
  "license": "MIT",
  "author": "Menelaos Ioannou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MenelaosI/react-natal-chart.git"
  },
  "homepage": "https://github.com/MenelaosI/react-natal-chart#readme",
  "bugs": {
    "url": "https://github.com/MenelaosI/react-natal-chart/issues"
  },
  "keywords": [
    "react",
    "astrology",
    "natal-chart",
    "svg",
    "horoscope"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --passWithNoTests",
    "example": "npm run build && node scripts/generate-example.cjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "circular-natal-horoscope-js": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "circular-natal-horoscope-js": "^1.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.0"
  }
}
